# HydroSense Backend example configuration
# Copy this file as ".env" and enter your private values there.
# Never place real passwords or credentials in this example file.

PORT=5000
NODE_ENV=development

# MongoDB Atlas connection
MONGODB_URI=mongodb+srv://YOUR_USERNAME:YOUR_PASSWORD@YOUR_CLUSTER/hydrosense?retryWrites=true&w=majority

# Allowed frontend origin
# Use * only during local development.
CORS_ORIGIN=*

# Mark the device offline after this duration without realtime data.
DEVICE_OFFLINE_MS=15000

# Minimum interval between device metadata database updates.
DEVICE_DB_TOUCH_INTERVAL_MS=30000

# Python command used for the ML worker.
# Windows usually uses: python
# Linux/macOS usually uses: python3
PYTHON_EXECUTABLE=python