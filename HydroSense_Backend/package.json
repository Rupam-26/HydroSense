{
  "name": "hydrosense-backend",
  "version": "1.0.0",
  "description": "Backend, realtime dashboard, telemetry storage and TinyML baseline services for the HydroSense system.",
  "main": "server.js",
  "private": true,
  "type": "commonjs",
  "scripts": {
    "start": "node server.js",
    "dev": "nodemon server.js",
    "test": "node --test",
    "check": "node --check server.js && node --test",
    "audit": "npm audit --omit=dev"
  },
  "keywords": [
    "hydrosense",
    "esp32",
    "iot",
    "hydroponics",
    "tinyml",
    "mongodb",
    "socket.io"
