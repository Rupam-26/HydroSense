root = true

[*]
charset = utf-8
end_of_line = lf
insert_final_newline = true
trim_trailing_whitespace = true

[*.{h,cpp,c}]
indent_style = space
indent_size = 4

[*.ini]
indent_style = space
indent_size = 4

[*.{yml,yaml,json,jsonc}]
indent_style = space
indent_size = 2

[*.md]
trim_trailing_whitespace = false

[LICENSE]
insert_final_newline = true